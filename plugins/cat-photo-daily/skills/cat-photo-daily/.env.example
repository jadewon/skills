# Slack bot token (chat.postMessage + files upload + conversations.history) — xoxb-...
# 봇 이름으로 게시된다(개인 토큰 아님).
# chat:write      — cat-post.sh 발송
# files:write      — cat-post.sh 가 사진을 첨부파일로 업로드한다
# channels:history — cat-recent.sh 가 최근 코멘트를 읽어 같은 표현 반복을 피한다
SLACK_BOT_TOKEN=

# 대상 채널 ID (예: C0XXXXXXX)
SLACK_CHANNEL=
